# Fusion CashApp web settings. Placeholders only. Server-side variables are validated at boot
# (web/instrumentation.ts). Nothing secret ever goes in a NEXT_PUBLIC_* variable.

OIDC_ISSUER=<https://idcs-xxxx.identity.oraclecloud.com>
OIDC_CLIENT_ID=<confidential-app-client-id>
OIDC_CLIENT_SECRET=<set-in-the-deploy-environment>
SESSION_SECRET=<random-string-of-at-least-32-characters>
API_BASE_URL=<http://localhost:8000>
APP_BASE_URL=<http://localhost:3000>

# Public (inlined into the browser bundle)
NEXT_PUBLIC_ENV_LABEL=LOCAL
