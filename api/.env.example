# Fusion CashApp API bootstrap settings. Placeholders only; real values come from the
# environment or OCI Vault.
#
# Only what a process needs before it can read the database lives here. Every other setting
# (event bus, Object Storage, Claude API, OCI Generative AI, sign-in, Fusion pods, observability,
# worker, intake folder, SMTP) is a DB config key edited in Settings. See docs/reference/settings.md.
# Any value below may be `vault:<secret-ocid>`; it is resolved once at startup.

CASHAPP_ENV=local

# Autonomous Database (thin mode; set the wallet vars when using a wallet)
CASHAPP_ATP__DSN=<tns-alias-or-connect-descriptor>
CASHAPP_ATP__USER=<db-user>
CASHAPP_ATP__PASSWORD=vault:ocid1.vaultsecret.oc1.iad.<atp-password>
CASHAPP_ATP__WALLET_DIR=
CASHAPP_ATP__WALLET_PASSWORD=
CASHAPP_ATP__POOL_SIZE=5
CASHAPP_ATP__MAX_OVERFLOW=10
CASHAPP_ATP__POOL_TIMEOUT_SECONDS=30

# Worker host health port (bound before the database is reachable)
CASHAPP_WORKER__HEALTH_PORT=8081

# How secrets are reached. Empty means: the local value map when CASHAPP_ENV=local, else OCI Vault
# using the platform's resource principal (or the instance principal on compute).
CASHAPP_SECRETS__SOURCE=
CASHAPP_SECRETS__SIGNER=
# Local only: a JSON map of secret OCID to value, e.g.
# CASHAPP_SECRETS__LOCAL_VALUES={"ocid1.vaultsecret.oc1.iad.<atp-password>":"local-password"}
CASHAPP_SECRETS__LOCAL_VALUES=
