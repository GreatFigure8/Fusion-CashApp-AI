# Fusion CashApp API bootstrap settings. Placeholders only; real values come from the
# deployment environment, never from the repository.
#
# Only what a process needs before it can read the database lives here: the database connection
# and the key that decrypts the secrets stored in the database. Every other setting (event bus,
# Object Storage, Claude API, OCI Generative AI, sign-in, Fusion pods, observability, worker,
# intake folder, SMTP) is a DB config key edited in Settings, and every secret is stored
# encrypted in the database and set on the Settings page. See docs/reference/settings.md.

CASHAPP_ENV=local

# Autonomous Database (thin mode; set the wallet vars when using a wallet)
CASHAPP_ATP__DSN=<tns-alias-or-connect-descriptor>
CASHAPP_ATP__USER=<db-user>
CASHAPP_ATP__PASSWORD=<db-password>
CASHAPP_ATP__WALLET_DIR=
CASHAPP_ATP__WALLET_PASSWORD=
CASHAPP_ATP__POOL_SIZE=5
CASHAPP_ATP__MAX_OVERFLOW=10
CASHAPP_ATP__POOL_TIMEOUT_SECONDS=30

# Worker host health port (bound before the database is reachable)
CASHAPP_WORKER__HEALTH_PORT=8081

# Master key for the secrets stored in the database: base64 of 32 random bytes. Generate once with
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# Keep it out of the database and the repo. Losing it makes every stored secret unreadable; they
# would have to be set again.
CASHAPP_SECRETS__MASTER_KEY=

# Optional switch: "db" (default), "vault" (OCI Vault) or "env" (local value map, tests).
CASHAPP_SECRETS__SOURCE=
CASHAPP_SECRETS__SIGNER=
# Local value map, only with source=env: secret name to value.
CASHAPP_SECRETS__LOCAL_VALUES=
