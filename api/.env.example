# Fusion CashApp API settings. Placeholders only; real values come from the environment or OCI Vault.
# Any value may be `vault:<secret-ocid>`; it is resolved once at startup (Vault unless env=local).

CASHAPP_ENV=local

# Autonomous Database (thin mode; set the wallet vars when using a wallet)
CASHAPP_ATP__DSN=<tns-alias-or-connect-descriptor>
CASHAPP_ATP__USER=<db-user>
CASHAPP_ATP__PASSWORD=vault:ocid1.vaultsecret.oc1.iad.<atp-password>
CASHAPP_ATP__WALLET_DIR=
CASHAPP_ATP__WALLET_PASSWORD=
CASHAPP_ATP__POOL_SIZE=5
CASHAPP_ATP__MAX_OVERFLOW=10
CASHAPP_ATP__POOL_TIMEOUT_SECONDS=30

# OCI Streaming (Kafka endpoint, SASL_SSL)
CASHAPP_STREAMING__BOOTSTRAP_SERVERS=<cell-1.streaming.us-ashburn-1.oci.oraclecloud.com:9092>
CASHAPP_STREAMING__SASL_USERNAME=<tenancy>/<user>/<stream-pool-ocid>
CASHAPP_STREAMING__SASL_PASSWORD=vault:ocid1.vaultsecret.oc1.iad.<streaming-token>
CASHAPP_STREAMING__TOPIC_PREFIX=cashapp
CASHAPP_STREAMING__CONSUMER_GROUP=<consumer-group>
CASHAPP_STREAMING__ENV=

# Object Storage (Ashburn only)
CASHAPP_OBJECT_STORAGE__NAMESPACE=<namespace>
CASHAPP_OBJECT_STORAGE__BUCKET=<bucket>
CASHAPP_OBJECT_STORAGE__REGION=us-ashburn-1

# Claude API (zero data retention)
CASHAPP_ANTHROPIC__API_KEY=vault:ocid1.vaultsecret.oc1.iad.<anthropic-key>
CASHAPP_ANTHROPIC__BASE_URL=

# OCI Generative AI (Cohere on a dedicated cluster)
CASHAPP_OCI_GENAI__ENDPOINT=https://inference.generativeai.us-ashburn-1.oci.oraclecloud.com
CASHAPP_OCI_GENAI__COMPARTMENT_OCID=<compartment-ocid>
CASHAPP_OCI_GENAI__DEDICATED_ENDPOINT_OCID=<dedicated-endpoint-ocid>

# OCI IAM Identity Domain (token validation)
CASHAPP_IDENTITY__ISSUER=<https://identity.oraclecloud.com/>
CASHAPP_IDENTITY__JWKS_URL=<https://idcs-xxxx.identity.oraclecloud.com/admin/v1/SigningCert/jwk>
CASHAPP_IDENTITY__AUDIENCE=<api-audience>
CASHAPP_IDENTITY__GROUPS_CLAIM=groups
CASHAPP_IDENTITY__BOOTSTRAP_ADMIN_GROUP=CashApp-Admins

# Oracle Fusion. One block per pod: CASHAPP_FUSION__PODS__<POD>__...
CASHAPP_FUSION__DEFAULT_POD=dev
CASHAPP_FUSION__WRITE_ENABLED=false
CASHAPP_FUSION__UNAPPLY_VERIFIED=false
CASHAPP_FUSION__RELATIONSHIPS_REPORT_PATH=</Custom/CashApp/Relationships.xdo>
CASHAPP_FUSION__PODS__DEV__BASE_URL=<https://pod.fa.us2.oraclecloud.com>
CASHAPP_FUSION__PODS__DEV__USERNAME=<integration-user>
CASHAPP_FUSION__PODS__DEV__PASSWORD=vault:ocid1.vaultsecret.oc1.iad.<fusion-dev-password>
CASHAPP_FUSION__PODS__DEV__IS_PRODUCTION=false
CASHAPP_FUSION__PODS__DEV__TESTDATA__BUSINESS_UNIT=<business-unit>
CASHAPP_FUSION__PODS__DEV__TESTDATA__TRANSACTION_TYPE=<transaction-type>
CASHAPP_FUSION__PODS__DEV__TESTDATA__RECEIPT_METHOD=<receipt-method>
CASHAPP_FUSION__PODS__DEV__TESTDATA__BANK_ACCOUNT=<bank-account>

# Observability
CASHAPP_OBSERVABILITY__LOG_LEVEL=INFO
CASHAPP_OBSERVABILITY__OTLP_ENDPOINT=
CASHAPP_OBSERVABILITY__OCI_MONITORING_NAMESPACE=cashapp

# Worker host
CASHAPP_WORKER__HEALTH_PORT=8081
CASHAPP_WORKER__SHUTDOWN_GRACE_SECONDS=30

# Intake
CASHAPP_INTAKE__DROP_FOLDER=<./drop>

# SMTP (optional; leave the whole block unset to disable notifications)
CASHAPP_SMTP__HOST=<smtp-host>
CASHAPP_SMTP__PORT=587
CASHAPP_SMTP__USERNAME=<smtp-user>
CASHAPP_SMTP__PASSWORD=vault:ocid1.vaultsecret.oc1.iad.<smtp-password>
CASHAPP_SMTP__FROM_ADDRESS=<cashapp@example.com>
